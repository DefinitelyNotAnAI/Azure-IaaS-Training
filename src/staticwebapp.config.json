{
  "routes": [
    {
      "route": "/config.js",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/app.js",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/module1.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/module2.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/module3.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/admin.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "*.css", "*.js", "*.html", "*.json"]
  }
}
